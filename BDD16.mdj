						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGdxBrQUzjvY8s=",
							"_parent": {
								"$ref": "AAAAAAFF+qBtyKM79qY="
							},
							"font": "Arial;13;0",
							"left": 928,
							"top": 304,
							"width": 241,
							"height": 352,
							"text": "Inserito Aggregazioni e Composizioni\nModifica x Debito spesa 1..*?\nTipoSpesa con due classi separate x diverse funzioni?\n\nDubbio su Notifica:\nCon il Sistema creato da noi si puo inviare solo un sollecito per persona e il debitore puo rispondere solo una volta.\n\nDefiniamo tipo Studente e Prof?\n\nProposte TipoGruppo\nCoinquilini: Pagaenti fissi mensili (Modifica x Utente Spesa)\nViaggio: Data inizio e Data fine\nStudio: Argomento(Materia o Progetto)\nRegalo: Una singola spesa?"
						}
					]
				},
